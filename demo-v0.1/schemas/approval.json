{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "plan_hash",
    "confirm"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^plan-[a-f0-9]{12}$"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "confirm": {
      "type": "boolean",
      "const": true
    }
  }
}
